# PRAMAN Backend Configuration Template

PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/pramaan

# Redis Connection
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Authentication Secrets
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Microservices
AI_SERVICE_URL=http://localhost:8000
CLIENT_ORIGIN=http://localhost:5173

# Verification Sandbox Keys (Optional)
SUREPASS_API_KEY=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
