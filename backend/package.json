{
  "name": "praman-backend",
  "version": "1.0.0",
  "description": "PRAMAN - Autonomous AI-Powered Public Procurement Bid Verification Engine Backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "build": "pip install --break-system-packages -r ai/requirements.txt || pip3 install --break-system-packages -r ai/requirements.txt || pip install -r ai/requirements.txt || true",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "seed:chaos": "node scripts/seed-chaos.js",
    "demo": "node scripts/demo-chaos.js",
    "chaos:on": "CHAOS_ENABLED=true node --watch server.js",
    "test:health": "curl -s http://localhost:5000/api/system/health | node -e \"process.stdin.on('data',d=>console.log(JSON.stringify(JSON.parse(d),null,2)))\""
  },
  "keywords": [
    "praman",
    "procurement",
    "verification",
    "express",
    "mongodb"
  ],
  "author": "PRAMAN Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
